# Copia este archivo como .env y rellena los valores.
# Clave de Vercel AI Gateway: https://vercel.com/dashboard -> AI Gateway -> API Keys
AI_GATEWAY_API_KEY=
# Modelo (opcional)
MODEL_AI=mistral/devstral-small-2
# URL(s) del frontend en producción, separadas por comas
ALLOWED_ORIGINS=
# Puerto local (opcional)
PORT=1234
