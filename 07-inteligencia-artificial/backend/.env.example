# Copia este archivo como .env para desarrollo local.
# En Vercel NO hace falta AI_GATEWAY_API_KEY: el AI Gateway se autentica con OIDC.
# Fuera de Vercel: https://vercel.com/dashboard -> AI Gateway -> API Keys
AI_GATEWAY_API_KEY=
# Modelo (opcional). Si se deja vacío o se borra la línea, se usa el de config.js
MODEL_AI=anthropic/claude-haiku-5.5
# Orígenes extra para CORS, separados por comas. No hace falta en Vercel
# Services (frontend y backend comparten dominio).
ALLOWED_ORIGINS=
# Puerto local (opcional)
PORT=1234
