# Copia este archivo como .env para desarrollo local.
# En Vercel NO hace falta AI_GATEWAY_API_KEY: el AI Gateway se autentica con OIDC.
# Fuera de Vercel: https://vercel.com/dashboard -> AI Gateway -> API Keys
AI_GATEWAY_API_KEY=

# Modelo principal (opcional). Si se deja vacío, se usa el de config.js.
# Ojo: en el plan gratuito de AI Gateway algunos modelos (p. ej. Claude) no están disponibles.
MODEL_AI=google/gemini-2.5-flash-lite

# Modelos de respaldo separados por comas (opcional). Vacío = sin respaldo.
# MODEL_AI_FALLBACKS=openai/gpt-5-mini

# Orígenes extra para CORS, separados por comas. No hace falta en Vercel
# Services (frontend y backend comparten dominio).
ALLOWED_ORIGINS=

# Puerto local (opcional)
PORT=1234
